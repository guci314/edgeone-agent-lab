# ─────────────────────────────────────────────────────────────────────
# 复制成 .env 后填。.env 已在 .gitignore 里。
#
# 线上部署时这些要配在 Makers 控制台的「环境变量」里，不是这个文件。
# `edgeone makers link` 可以把控制台的环境变量同步到本地调试。
# ─────────────────────────────────────────────────────────────────────

# ── 模型：OpenCode Go ───────────────────────────────────────────────
# 变量名沿用平台的 AI_GATEWAY_*，因为 edgeone.json 的 framework 适配、
# 以及模板惯例都读这三个名字。换成 OpenCode Go 只需要改值，不用改代码。
AI_GATEWAY_API_KEY=sk-你的-openCode-go-密钥
AI_GATEWAY_BASE_URL=https://opencode.ai/zen/go/v1
AI_GATEWAY_MODEL=deepseek-v4.1-flash

# OpenCode Go 要求带 x-opencode-session 头，缺了会被直接拒。
# 值只是个路由标签，随便取，但同一个项目内保持一致。
OPENCODE_SESSION=edgeone-agent-lab

# ── 飞书自建应用 ───────────────────────────────────────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 事件订阅页的 Verification Token
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# 加密策略里的 Encrypt Key。**强烈建议配** —— 不配就没有任何请求来源证明，
# 任何人都能伪造事件推送。见 src/feishu/crypto.ts 的说明。
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ── 内部调用令牌 ───────────────────────────────────────────────────
# 飞书 webhook（cloud-functions）转发给 agent（agents/feishu）时带的自制头。
# agents 路由是公网可达的，没有这道门任何人都能拿它烧你的模型额度。
# 生成：openssl rand -hex 24
INTERNAL_TOKEN=请换成随机串

# ── 调度模式 ───────────────────────────────────────────────────────
# async（默认）：agent 先回 202，再在后台跑完整个回合。webhook 立刻 ACK 飞书。
# sync         ：agent 跑完才返回。webhook 要等，但**不依赖后台执行能力**。
#
# 为什么会有这个开关：EdgeOne 的 agents/ 运行时会话粘性、实例保活 300 秒，
# 但「返回 Response 之后未 await 的异步代码还能不能跑完」官方没有明文承诺。
# 部署后先用 /feishu/agent 上的 ?probe=1 实测（见 docs/03-验证清单.md），
# 实测结果决定这里填哪个。
FEISHU_DISPATCH_MODE=async

# ── 可选：沙箱开关 ─────────────────────────────────────────────────
# 平台内置沙箱工具（commands / code_interpreter / files_* / browser_*）。
# 设成 0 / false / off 就整条不挂给模型。
SANDBOX_ENABLED=1

# ── 可选：GitHub 工作区（ws_ls / ws_read / ws_write / ws_delete）──
# 不配就这四个工具一个都不挂 —— 挂出来只会让模型反复试一个必然失败的工具。
# GITHUB_TOKEN=github_pat_xxx
# GH_WORKSPACE_REPO=owner/repo
# GH_WORKSPACE_BRANCH=main
