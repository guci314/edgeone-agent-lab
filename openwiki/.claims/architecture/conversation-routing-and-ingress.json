    {
      "id": "claim_77a16a8507dc4b458fccd3984d1170fb",
      "statement": "The webhook validates the incoming chat_id against CHAT_ID_RE = /^oc_[A-Za-z0-9_-]{1,64}$/ before hashing, because a signature-valid but synthetically constructed payload could otherwise mint unbounded conversation instances, each with its own memory and store namespace.",
      "evidence": [
        {
          "resource": "repo://cloud-functions/feishu-webhook/index.ts#L188-L188",
          "version": "repo-lines-v1:sha256:db49f51ea736b1fc9c160d17f538418a09bf286baf281d8abbb662d6785acf76:"
