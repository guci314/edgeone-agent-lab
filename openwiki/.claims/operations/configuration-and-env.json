    {
      "id": "claim_021783991f2a4b66a5f20cd62a544800",
      "statement": "Cross-session memory resolves its Blob namespace from projectId fallbacks checked in both context.env and process.env (env.PAGES_PROJECT_ID → env.ProjectId → process.env.PAGES_PROJECT_ID → process.env.ProjectId → process.env.EDGEONE_PROJECT_ID), or from an explicit AGENT_MEMORY_NAMESPACE; when getStore or projectId is unavailable the backend resolves to null so memory tools and the prompt's memory section disappear entirely instead of degrading to a per-turn fake.",
      "evidence": [
        {
          "resource": "repo://agents/feishu/_host.ts#L292-L305",
