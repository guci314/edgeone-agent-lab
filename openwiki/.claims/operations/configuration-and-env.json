    {
      "id": "claim_7a4f25115ebc4fd99f6bf4caa3354708",
      "statement": "OpenWiki does not read .gitignore and reads the workspace rather than the git index, so .openwikiignore is the only exclusion file it honors; it must explicitly list .env and its variants, otherwise live secrets would be read as corpus and written into the git-committed openwiki/ pages (a second-order leak after the earlier .env exposure incident).",
      "evidence": [
        {
          "resource": "repo://.gitignore#L1-L14",
          "version": "repo-lines-v1:sha256:d2d93a37811c8df369b75f65f0a4ae5800dab5dfbea38d75a0232466c347a89c:"
        },
        {
