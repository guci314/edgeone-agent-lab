        }
      ]
    },
    {
      "id": "claim_a0b85169edc84424b665aa3e45ab0b61",
      "statement": "The bridge's conversation-id contract differs from the deployed webhook's in one respect: bridge/index.mjs sends INTERNAL_TOKEN in both the x-internal-token header and the body's token field, while cloud-functions/feishu-webhook/index.ts sends only the header. This dual-send is a deliberate fallback because the agents runtime's context.request.headers is not a standard Headers instance (typeof headers.get is undefined), which previously made every forwarded request return 401 with a misleading 'token mismatch' message.",
      "evidence": [
        {
          "resource": "repo://agents/feishu/index.ts#L973-L997",
          "version": "repo-lines-v1:sha256:bea3713f17e854f0c9b4c371728267301847da53f8135ddf4c6b32c71d0215a0:"
        },
        {
