    {
      "id": "claim_5274d783980f42628f7284068eeade1d",
      "statement": "agents/feishu accepts two inbound shapes on the same route: normal message events (dedupe → rate limit → dispatch) and the cloud-document OAuth callback identified by body.op === \"oauth\", which is handled before the dedupe/rate-limit claim and returns synchronously because the relay's browser is waiting for that response to render the result page — applying the user-message dedupe logic to a retried OAuth callback would silently drop the second attempt.",
      "evidence": [
        {
          "resource": "repo://agents/feishu/index.ts#L109-L120",
          "version": "repo-lines-v1:sha256:a3b1a0ce35e4fd481463288bba9e9c88c9fdbff80ed221a0e5df6b1cfd90e139:"
