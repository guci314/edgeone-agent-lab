{
  "name": "edgeone-agent-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "cf-agent-lab 的 EdgeOne Makers 移植版：飞书通用助手（OpenAI Agents SDK）",
  "scripts": {
    "link": "edgeone makers link",
    "dev": "edgeone makers dev",
    "deploy": "npm run clean:zip && edgeone makers deploy",
    "clean:zip": "rm -f edgeone-agent-lab.zip",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types test/smoke.ts",
    "ask": "node tools/ask-bot.mjs",
    "verify:memory": "node tools/verify-memory.mjs",
    "verify:autocompact": "node tools/verify-autocompact.mjs",
    "sandcastle": "npx tsx .sandcastle/main.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.11.4",
    "openai": "^6.35.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@types/node": "^22.10.0",
    "edgeone": "^1.6.41",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  }
}
