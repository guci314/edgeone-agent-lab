    {
      "id": "claim_d3ccccf685e842ca93babde66cda2511",
      "statement": "`runFeishuTurn` 用 `switch (cmd.kind)` 分派：compact / clear / memory / forget / login / logout 通过 `safeReply(() => host.<method>())` 调用宿主并用兜底文案接住异常；help 直接发 `HELP_TEXT` 常量、error 直接发 `cmd.message`；status 走 `host.statusText()` 但不包 `safeReply`，是唯一没有兜底的宿主调用分支。",
      "evidence": [
        {
          "resource": "repo://src/feishu/turn.ts#L111-L146",
          "version": "repo-lines-v1:sha256:1bfabd90a339f42c8ec91c94fe25aad7526eae21cd901dd407ca2c65202760c4:"
        }
