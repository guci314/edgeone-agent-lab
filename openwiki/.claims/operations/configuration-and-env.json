    {
      "id": "claim_856835d1363f490d93745ced1c7d21e0",
      "statement": "resolveModelRoute(env) picks credentials and base URL strictly by source as a pair — OPENCODE_* if both OPENCODE_API_KEY and OPENCODE_BASE_URL are non-empty, otherwise AI_GATEWAY_* if both are present, otherwise both undefined with source '未配置' — so a half-configured pair is treated as entirely unconfigured rather than mixing a key from one gateway with a URL from another (which caused stable 401 API key not found).",
      "evidence": [
        {
          "resource": "repo://agents/feishu/_host.ts#L219-L256",
          "version": "repo-lines-v1:sha256:f9d84a8d144f742f57fcb40b121e27ef3838d721aca395b671df9f081727d857:"
